ENVIRONMENT=dev
LOG_LEVEL=INFO

DATABASE_URL=postgresql://postgres:deskpilot@localhost:5432/postgres
REDIS_URL=redis://localhost:6379/0

LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=
# The assistant talks to any OpenAI-compatible API. Defaults to Groq.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
# A model that supports tool calling, for example openai/gpt-oss-120b (check Groq's model list)
LLM_MODEL=
# Alerts (all optional; with none set, alerts are printed to the console)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=
# API: if API_TOKEN is set, requests need "Authorization: Bearer <token>". Chat is off unless enabled.
API_TOKEN=
API_ENABLE_CHAT=false
# Redis Streams between ingestion and everything else (API follows the stream when USE_REDIS=true)
USE_REDIS=false
TICK_STREAM=ticks
TICK_STREAM_MAXLEN=200000